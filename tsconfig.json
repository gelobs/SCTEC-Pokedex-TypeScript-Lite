{
  "compilerOptions": {
    "rootDir": "./SCTEC-Pokedex-TypeScript-Lite",
    "outDir": "./dist",
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "sourceMap": true,
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["/**/*"],
  "exclude": ["node_modules", "dist"]
}
